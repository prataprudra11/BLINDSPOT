{
  "manifest_version": 3,
  "name": "AI Agent Assistant",
  "version": "1.0.0",
  "description": "Chrome Extension skeleton with message-passing plumbing and backend server relay.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "element-mapper.js",
        "action-schema.js",
        "action-validator.js",
        "action-executor.js",
        "redaction.js",
        "vision/vision-trigger.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vision/*",
        "vision/vendor/*",
        "vision/vendor/*.js",
        "vision/vendor/*.wasm",
        "vision/vendor/worker.min.js",
        "vision/vendor/tesseract.min.js",
        "vision/vendor/tesseract-core.wasm",
        "vision/vendor/tesseract-core.wasm.js",
        "vision/vendor/tessdata/*",
        "vision/vendor/tessdata/*.gz",
        "vision/vendor/tessdata/eng.traineddata.gz"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Agent Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
